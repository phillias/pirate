# Pirate suite environment template.
#
# setup.sh renders this file into .env (envsubst, every `${VAR}` below).
# Normal deployments source secrets from the BWS phillias project as
# PIRATE_<VAR>; vault values win and vault-only secrets are written blank.
# Without BWS, copy this file to .env, replace each "${VAR}" placeholder with
# its real value, then run ./setup.sh — plaintext values survive re-renders.

# ── Host / compose ─────────────────────────────────────────────
# Compose project name; also prefixes the shelfmark-secrets volume.
COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME}"
# Container user/group IDs (usually `id -u` / `id -g`) and timezone (e.g. UTC).
PUID="${PUID}"
PGID="${PGID}"
TZ="${TZ}"
# Host path of the rclone gdrive-phillias mount (empty = compose default).
GDRIVE_PHILLIAS_PATH="${GDRIVE_PHILLIAS_PATH}"

# ── Database (grimmory → host MariaDB) ─────────────────────────
# MariaDB user/password for the grimmory database.
DATABASE_USERNAME="${DATABASE_USERNAME}"
DATABASE_PASSWORD="${DATABASE_PASSWORD}"

# ── VPN: Proton (gluetun) ──────────────────────────────────────
# WireGuard PrivateKey from a Proton config (account.protonvpn.com/downloads).
WIREGUARD_PRIVATE_KEY="${WIREGUARD_PRIVATE_KEY}"
# gluetun shadowsocks password (random string).
SHADOWSOCKS_PASSWORD="${SHADOWSOCKS_PASSWORD}"
# gluetun HTTP control server auth role (random string).
HTTP_CONTROL_SERVER_AUTH="${HTTP_CONTROL_SERVER_AUTH}"

# ── Proxy: Cloudflare WARP ─────────────────────────────────────
# From warp/conf.json after registration (own_public_key, registration_id,
# account.id, account.license); greenfield.sh can extract them.
WARP_OWN_PUBLIC_KEY="${WARP_OWN_PUBLIC_KEY}"
WARP_REGISTRATION_ID="${WARP_REGISTRATION_ID}"
WARP_ACCOUNT_ID="${WARP_ACCOUNT_ID}"
WARP_ACCOUNT_LICENSE="${WARP_ACCOUNT_LICENSE}"

# ── Debrid / Usenet indexers ───────────────────────────────────
# Torbox API key (torbox.app/settings); used by decypharr, NZBHydra2, AIOStreams.
TORBOX_API_KEY="${TORBOX_API_KEY}"
# NZB indexer API keys from each indexer account (used by NZBHydra2).
NZBNOOB_API_KEY="${NZBNOOB_API_KEY}"
SCENENZBS_API_KEY="${SCENENZBS_API_KEY}"
MIATRIX_API_KEY="${MIATRIX_API_KEY}"

# ── Prowlarr ───────────────────────────────────────────────────
# Prowlarr API key (32 hex chars).
PROWLARR_API_KEY="${PROWLARR_API_KEY}"

# ── Jackett ────────────────────────────────────────────────────
# API key (32 hex chars), admin UI password, instance ID (UUID).
JACKETT_API_KEY="${JACKETT_API_KEY}"
JACKETT_ADMIN_PASSWORD="${JACKETT_ADMIN_PASSWORD}"
JACKETT_INSTANCE_ID="${JACKETT_INSTANCE_ID}"
# OMDb API key (omdbapi.com/apikey.aspx).
JACKETT_OMDB_KEY="${JACKETT_OMDB_KEY}"

# ── NZBHydra2 ──────────────────────────────────────────────────
# API key (32 hex chars) and web UI password.
NZBHYDRA2_API_KEY="${NZBHYDRA2_API_KEY}"
NZBHYDRA2_PASSWORD="${NZBHYDRA2_PASSWORD}"

# ── Shelfmark / qBittorrent client ─────────────────────────────
# Flask session secret, base64-encoded (`openssl rand -base64 32`).
SHELFMARK_FLASK_SECRET="${SHELFMARK_FLASK_SECRET}"
# Built-in login; the hash is Werkzeug scrypt format (scrypt:32768:8:1$salt$hex).
SHELFMARK_BUILTIN_USERNAME="${SHELFMARK_BUILTIN_USERNAME}"
SHELFMARK_BUILTIN_PASSWORD_HASH="${SHELFMARK_BUILTIN_PASSWORD_HASH}"
# qBittorrent credentials shelfmark uses for downloads.
QBITTORRENT_USERNAME="${QBITTORRENT_USERNAME}"
QBITTORRENT_PASSWORD="${QBITTORRENT_PASSWORD}"

# ── Storyteller ────────────────────────────────────────────────
# Session secret (random string).
STORYTELLER_SECRET_KEY="${STORYTELLER_SECRET_KEY}"

# ── AIOStreams ─────────────────────────────────────────────────
# Instance secret key and addon password (random strings).
AIOS_SECRET_KEY="${AIOS_SECRET_KEY}"
AIOS_ADDON_PASSWORD="${AIOS_ADDON_PASSWORD}"
# Google Cloud Console OAuth client secret.
AIOS_GDRIVE_CLIENT_SECRET="${AIOS_GDRIVE_CLIENT_SECRET}"
# TMDB read access token and API key (themoviedb.org/settings/api).
AIOS_TMDB_ACCESS_TOKEN="${AIOS_TMDB_ACCESS_TOKEN}"
AIOS_TMDB_API_KEY="${AIOS_TMDB_API_KEY}"
# TVDB API key (thetvdb.com/api-information).
AIOS_TVDB_API_KEY="${AIOS_TVDB_API_KEY}"

# ── Backups (restic, S3/OCI-compatible) ────────────────────────
# Repository URL, encryption password, and bucket credentials.
RESTIC_REPOSITORY="${RESTIC_REPOSITORY}"
RESTIC_PASSWORD="${RESTIC_PASSWORD}"
AWS_ACCESS_KEY_ID="${AWS_ACCESS_KEY_ID}"
AWS_SECRET_ACCESS_KEY="${AWS_SECRET_ACCESS_KEY}"
