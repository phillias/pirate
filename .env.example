# Pirate stack environment — copy to .env and fill in non-secret values.
# Secret values are sourced from BWS (phillias project, PIRATE_ prefix)
# at render time by setup.sh. See setup.sh for the overlay behavior.
#
# .env is gitignored; never commit secret values to this public repo.
# Consumed by compose.yaml (${...}) and templates via envsubst.

# Base (non-secret)
PUID=1000
PGID=1000
TZ=UTC

# grimmory — rendered into grimmory/secrets.env (templates/grimmory) and
# bind-mounted into the container; the host MariaDB must be reachable
# before grimmory starts.
DATABASE_USERNAME=
DATABASE_PASSWORD=

# proton (gluetun) — plain env vars consumed directly by compose.
SHADOWSOCKS_PASSWORD=
WIREGUARD_PRIVATE_KEY=
HTTP_CONTROL_SERVER_AUTH=
