# Pirate stack environment — copy to .env and fill in.
# .env is gitignored; never commit secret values to this public repo.
# Consumed by compose.yaml (${...}) and templates/grimmory/secrets.env.

# Base
PUID=
PGID=
TZ=

# grimmory — rendered into grimmory/secrets.env (templates/grimmory) and
# bind-mounted into the container; the host MariaDB must be reachable
# before grimmory starts.
DATABASE_USERNAME=
DATABASE_PASSWORD=

# proton (gluetun) — plain env vars replace the old locket-rendered
# /run/secrets files (proton-init / pirate_proton-secrets removed).
SHADOWSOCKS_PASSWORD=
WIREGUARD_PRIVATE_KEY=
HTTP_CONTROL_SERVER_AUTH=
