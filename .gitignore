shelfmark/settings.json
shelfmark/.flask_secret
proton/servers.json

# Restic credentials (contains OCI secret keys + restic passphrase)
.restic-env

# --- Cutover hardening (2026-10-03): runtime state + rendered secrets ---
# proton: gluetun rendered secrets (interpolated from .env at cutover)
proton/HTTP_CONTROL_SERVER_AUTH
proton/SHADOWSOCKS_PASSWORD
proton/WIREGUARD_PRIVATE_KEY
# grimmory: rendered secrets + runtime state
grimmory/secrets.env
grimmory/test-write
grimmory/images/
# jackett: runtime config dir (lowercase; Jackett/ seed data is tracked)
jackett/config/
# nzbhydra2: runtime config + downloads bind dirs
nzbhydra2/config/
nzbhydra2/downloads/
# prowlarr: runtime config + hot-backup DB files (main prowlarr.db tracked)
prowlarr/config/
prowlarr/data/prowlarr.db*
# decypharr: runtime data (auth.json credentials, config, cache, db, logs)
decypharr/data/
# storyteller: secrets + runtime DB + uploads + autoimport
storyteller/secrets.env
storyteller/storyteller.db*
storyteller/uploads/
storyteller/.autoimport/
# shelfmark: runtime user DB (settings.json/.flask_secret/covers already ignored; plugins/ tracked)
shelfmark/users.db*
# AIOS: runtime mapping/instance state
AIOS/data/id-mappings/
AIOS/data/scene-mappings/
AIOS/data/instance-id
# restic backup log (written by restic-backup.sh into repo dir)
restic-backup.log
# phase-2 prep secret archives (tarballs of env/DB exports)
.volume-exports/
